# openai retrieves code and, when OPENAI_API_KEY is set, asks that API to write
# the answer. ollama asks a model running on the host instead. Leave this as
# openai with a blank key to print the retrieved code only.
LLM_PROVIDER=openai

# Hosted model. OPENAI_MODEL writes the answer. OPENAI_RETRIEVAL_MODEL is the
# smaller model that turns a question into search queries.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_RETRIEVAL_MODEL=gpt-4o-mini

# Local Ollama. The container reaches the Mac or PC at host.docker.internal.
# qwen2.5-coder:7b is the fast choice. For a closer reading of the retrieved
# code, set OLLAMA_MODEL=qwen2.5-coder:32b-instruct-q5_K_M and leave
# OLLAMA_RETRIEVAL_MODEL on the 7b model so the small model only plans the search.
# Raise OLLAMA_NUM_CTX to 16384 when the machine still has memory after the
# model is loaded. Ollama otherwise keeps only a few thousand tokens.
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5-coder:7b
OLLAMA_RETRIEVAL_MODEL=qwen2.5-coder:7b
OLLAMA_NUM_CTX=8192
OLLAMA_TIMEOUT=600

# Optional. Used only to clone private GitHub repositories.
GITHUB_TOKEN=

# Vector index used when a query does not pass --index.
# text is the general-English model (BAAI/bge-small-en-v1.5, 384 dimensions).
# code is jinaai/jina-embeddings-v2-base-code (768 dimensions).
# both merges the two rankings with reciprocal rank fusion.
RAG_INDEX=text

# How keyword ranks join the vector ranking.
# score is the default. It adds cosine similarity to ts_rank_cd, which is the
# sum this app used before the second index, so an ordinary query keeps that
# order. Cosine similarity is usually the larger number, so the vector ranking
# leads and the keyword rank nudges it.
# rrf (reciprocal rank fusion) gives the keyword list an equal vote with each
# vector list. Use it when an exact word should compete with a close passage.
# RRF_K is the fusion constant; 60 is the usual value.
RAG_FUSION=score
RRF_K=60

# The text model. Leave these at the defaults unless you are building a new volume.
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384

# The code model, stored beside the text model on every chunk.
CODE_EMBEDDING_MODEL=jinaai/jina-embeddings-v2-base-code
CODE_EMBEDDING_DIM=768
