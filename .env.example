# openai retrieves code and, when OPENAI_API_KEY is set, asks that API to write
# the answer. ollama asks a model running on the host instead. Leave this as
# openai with a blank key to print the retrieved code only.
LLM_PROVIDER=openai

# Hosted model.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Local Ollama. The container reaches the Mac or PC at host.docker.internal.
# qwen2.5-coder:7b is the fast choice. For a closer reading of the retrieved
# code, set OLLAMA_MODEL=qwen2.5-coder:32b-instruct-q5_K_M.
# Raise OLLAMA_NUM_CTX to 16384 when the machine still has memory after the
# model is loaded. Ollama otherwise keeps only a few thousand tokens.
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5-coder:7b
OLLAMA_NUM_CTX=8192
OLLAMA_TIMEOUT=600

# Optional. Used only to clone private GitHub repositories.
GITHUB_TOKEN=
